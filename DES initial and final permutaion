// DES Initial Permutation on 64-bit hex input
#include <iostream>
#include <bitset>
#include <string>
#include <iomanip>
using namespace std;

// Standard DES Initial Permutation table (1-indexed bit positions)
int IP[64] = {
    58,50,42,34,26,18,10,2,
    60,52,44,36,28,20,12,4,
    62,54,46,38,30,22,14,6,
    64,56,48,40,32,24,16,8,
    57,49,41,33,25,17,9, 1,
    59,51,43,35,27,19,11,3,
    61,53,45,37,29,21,13,5,
    63,55,47,39,31,23,15,7
};

int main() {
    string hexInput;
    cout << "Enter 64-bit hex (16 hex chars): ";
    cin >> hexInput;

    // Convert hex to 64-bit integer
    unsigned long long val = stoull(hexInput, nullptr, 16);
    bitset<64> bits(val);

    // Apply IP: output bit i = input bit (IP[i]-1)
    bitset<64> out;
    for (int i = 0; i < 64; i++) {
        // IP table is 1-indexed; bit 1 = MSB = position 63 in bitset
        out[63 - i] = bits[64 - IP[i]];
    }

    cout << "\n--- DES Initial Permutation ---\n";
    cout << "Input  (bin): " << bits << "\n";
    cout << "Output (bin): " << out  << "\n";
    cout << "Output (hex): "
         << uppercase << hex << setw(16) << setfill('0')
         << out.to_ullong() << "\n";
    return 0;
}

/* Sample I/O:
   Input : 0123456789ABCDEF
   Output: CC00CCFFF0AAF0AA

   (Classic DES test vector — widely used in textbooks)
*/
